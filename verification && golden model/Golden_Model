"""
================================================================================
IEEE SSCS Egypt Chapter - 2026 Student Design Competition
Golden Reference Model for the FPGA-Based Edge-AI Vision Accelerator
================================================================================

Implements, in plain NumPy (no ML framework / no dataset download required),
an NxN valid convolution (stride 1, cross-correlation, no kernel flip - this
is the CNN convention and is the same operation nn.Conv2d performs) over an
unsigned fixed-point input image, using signed 8-bit quantized kernel weights,
per the competition specification.

THIS FILE IS THE COUNTERPART OF tb_cnn_top.sv / cnn_config.vh.
All three must agree on IMAGE_SIZE, KERNEL_SIZE, DATA_WIDTH, and OUTPUT_WIDTH.
The Config class below mirrors cnn_config.vh exactly - if you change one,
change the other and regenerate.

The testbench reads exactly three files via $readmemh, all HEX text, one
value per line, two's-complement for signed fields:
  - kernel.mem        NUM_WEIGHTS (=KERNEL_SIZE^2) lines, DATA_WIDTH-bit signed
  - image.mem         IMAGE_SIZE^2 lines, DATA_WIDTH-bit unsigned, row-major
  - relu_output.mem   OUT_DIM^2 lines, 16-bit signed (ReLU + saturated), row-major
    (the tb hardcodes golden_mem as 16 bits and sign-extends it up to whatever
    OUTPUT_WIDTH the DUT uses, so the golden file itself is always 16-bit
    regardless of OUTPUT_WIDTH - this script sets OUTPUT_WIDTH=16 to match)

Design notes vs. the earlier draft:
  1. Fully reproducible - a fixed seed drives all "random" weight/image
     generation, so the exported golden files never change between runs
     unless you deliberately change the seed or parameters.
  2. No external dependencies (no torch/torchvision, no CIFAR-10 download).
  3. Single kernel/single output feature map, matching tb_cnn_top.sv's
     interface (one kernel_rom, one output_pixels stream). Multiple
     kernels are a spec bonus item, not the baseline interface here.
  4. NxN kernel size is a single config parameter, not hardcoded in three
     places - change Config.KERNEL_SIZE and everything (weights, output
     shapes, .mem grouping) follows automatically.
  5. ReLU is applied by default (the tb's file is literally named
     relu_output.mem) but the flag is exposed so you can flip it off and
     regenerate raw (linear) golden data if your design doesn't implement
     the ReLU bonus.
  6. All arithmetic is done in the integer domain from the start (no floats
     anywhere in the compute path), so there is no float->int truncation
     risk when exporting.
  7. Output values are saturated to the 16-bit signed range the tb expects.
     The script reports the worst-case theoretical output magnitude and
     warns whenever a specific test image actually saturates, which is
     exactly what spec item 6 asks you to explain in the report.
  8. Besides the primary kernel.mem/image.mem/relu_output.mem set consumed
     directly by the testbench, extra edge-case vectors (all-zero,
     full-scale, checkerboard, ramp) are generated under export/vectors/
     for broader coverage - swap them in by pointing $readmemh at that
     folder, or copying the files over the primary ones, for extra runs.
  9. A manifest (JSON) is exported alongside the data, documenting every
     assumption, ready to drop into the report's Table 1.

================================================================================
"""

import numpy as np
import os
import json


# ==============================================================================
# 0. Configuration
# ==============================================================================
class Config:
    PROJECT_NAME = "EDGE_AI_VISION_ACCELERATOR"
    VERSION = "4.0.0 (tb_cnn_top.sv compatible)"

    SEED = 42  # fixes reproducibility: same seed -> byte-identical exports every run

    # ---- Must exactly match cnn_config.vh ----
    IMAGE_SIZE   = 32   # `IMAGE_SIZE   - spec #1: minimum 32x32, single-channel input
    KERNEL_SIZE  = 3    # `KERNEL_SIZE  - spec #3: N x N, programmable coefficients
    DATA_WIDTH   = 8    # `DATA_WIDTH   - spec #2 (unsigned input) / #4 (signed weight)
    OUTPUT_WIDTH = 16   # `OUTPUT_WIDTH - spec #6: minimum 16-bit signed output

    NUM_FILTERS = 1      # tb_cnn_top.sv has a single kernel_rom / single output stream
    STRIDE      = 1      # spec #5: convolution must use stride 1 (fixed, not configurable)

    APPLY_RELU    = True        # tb reads "relu_output.mem" -> ReLU is expected applied
    OVERFLOW_MODE = "saturate"  # "saturate" (clamp) or "wrap" (two's-complement wrap)
                                 # MUST match whatever your RTL actually implements

    EXPORT_DIR = "./export_Test"

    # ---- Derived helpers ----
    @staticmethod
    def input_max():
        return (1 << Config.DATA_WIDTH) - 1  # 255 for 8-bit unsigned

    @staticmethod
    def weight_range():
        half = 1 << (Config.DATA_WIDTH - 1)
        return -half, half - 1  # (-128, 127) for 8-bit signed

    @staticmethod
    def output_range():
        half = 1 << (Config.OUTPUT_WIDTH - 1)
        return -half, half - 1  # (-32768, 32767) for 16-bit signed

    @staticmethod
    def worst_case_abs_output():
        _, wmax = Config.weight_range()
        return (Config.KERNEL_SIZE ** 2) * wmax * Config.input_max()

    @staticmethod
    def min_bits_for_worst_case():
        wc = Config.worst_case_abs_output()
        return int(np.ceil(np.log2(wc + 1))) + 1  # +1 for sign bit

    @staticmethod
    def banner():
        oh = ow = Config.IMAGE_SIZE - Config.KERNEL_SIZE + 1
        needed_bits = Config.min_bits_for_worst_case()
        print(f"\n{'=' * 80}")
        print(f"  {Config.PROJECT_NAME} - v{Config.VERSION}")
        print(f"  Input: {Config.IMAGE_SIZE}x{Config.IMAGE_SIZE} unsigned "
              f"{Config.DATA_WIDTH}-bit | Kernel: {Config.KERNEL_SIZE}x{Config.KERNEL_SIZE} "
              f"signed {Config.DATA_WIDTH}-bit | Filters: {Config.NUM_FILTERS}")
        print(f"  Output: {oh}x{ow}, {Config.OUTPUT_WIDTH}-bit signed, "
              f"overflow mode = '{Config.OVERFLOW_MODE}', ReLU = {Config.APPLY_RELU}")
        print(f"  Worst-case |output| = {Config.worst_case_abs_output()} "
              f"(needs >= {needed_bits}-bit signed to never overflow)")
        if needed_bits > Config.OUTPUT_WIDTH:
            print(f"  [NOTE] OUTPUT_WIDTH={Config.OUTPUT_WIDTH} is NARROWER than the "
                  f"worst case. Saturation WILL occur for extreme inputs (e.g. the "
                  f"'max_value' test vector) - this is expected and must be discussed "
                  f"in the report per spec item 6, and your RTL's output stage must "
                  f"implement the same saturation behavior for the golden compare to pass.")
        print(f"  Seed: {Config.SEED} (fixed -> exports are reproducible)")
        print(f"{'=' * 80}\n")


# ==============================================================================
# 1. Weight generation (reproducible, quantized signed int8) - a single N x N
#    kernel, matching tb_cnn_top.sv's single kernel_rom.
# ==============================================================================
def generate_weights(rng):
    """Returns int32 ndarray, shape (K, K), values in weight_range()."""
    K = Config.KERNEL_SIZE
    float_w = rng.standard_normal((K, K)).astype(np.float64)

    lo, hi = Config.weight_range()
    max_val = np.max(np.abs(float_w))
    scale = hi / max_val  # symmetric quantization about the positive max code

    int_w = np.round(float_w * scale)
    int_w = np.clip(int_w, lo, hi).astype(np.int32)
    return int_w


# ==============================================================================
# 2. Test image generation (synthetic, seeded, includes corner cases)
# ==============================================================================
def generate_test_images(rng):
    """Returns dict[name] -> int32 ndarray (IMAGE_SIZE, IMAGE_SIZE), unsigned range."""
    S = Config.IMAGE_SIZE
    vmax = Config.input_max()
    cases = {}

    cases["zeros"] = np.zeros((S, S), dtype=np.int32)
    cases["max_value"] = np.full((S, S), vmax, dtype=np.int32)

    idx = np.indices((S, S)).sum(axis=0)
    cases["checkerboard"] = ((idx % 2) * vmax).astype(np.int32)

    ramp_row = np.round(np.linspace(0, vmax, S)).astype(np.int32)
    cases["ramp"] = np.tile(ramp_row, (S, 1))

    cases["random"] = np.round(rng.random((S, S)) * vmax).astype(np.int32)

    return cases


# ==============================================================================
# 3. Convolution + overflow handling
# ==============================================================================
def cross_correlate_valid(img, kernel):
    """Valid (no padding) 2D cross-correlation, stride 1. Wide int64 accumulator
    so the RAW result is exact/unbounded - overflow is applied afterward,
    explicitly, so it can be inspected and reported rather than hidden."""
    H, W = img.shape
    K = kernel.shape[0]
    oh, ow = H - K + 1, W - K + 1
    out = np.zeros((oh, ow), dtype=np.int64)
    for i in range(oh):
        for j in range(ow):
            out[i, j] = np.sum(img[i:i + K, j:j + K].astype(np.int64) * kernel)
    return out


def apply_relu(x):
    return np.maximum(x, 0)


def apply_overflow(x, bit_width, mode):
    lo = -(1 << (bit_width - 1))
    hi = (1 << (bit_width - 1)) - 1
    if mode == "saturate":
        return np.clip(x, lo, hi), bool(np.any(x < lo) or np.any(x > hi))
    elif mode == "wrap":
        modv = 1 << bit_width
        wrapped = ((x - lo) % modv) + lo
        return wrapped, bool(np.any(x < lo) or np.any(x > hi))
    else:
        raise ValueError(f"Unknown OVERFLOW_MODE: {mode}")


# ==============================================================================
# 4. Export engine
# ==============================================================================
def to_twos_complement(val, bit_width):
    v = int(val)
    mask = (1 << bit_width) - 1
    return v & mask


class Exporter:
    def __init__(self, output_dir):
        self.output_dir = output_dir
        os.makedirs(self.output_dir, exist_ok=True)

    def save_hex_mem(self, filename, values, bit_width, comment=""):
        """$readmemh-compatible: one two's-complement hex value per line,
        row-major order, zero-padded to ceil(bit_width/4) hex digits."""
        path = os.path.join(self.output_dir, filename)
        digits = (bit_width + 3) // 4
        flat = np.asarray(values).reshape(-1)
        with open(path, "w") as f:
            for val in flat:
                f.write(f"{to_twos_complement(val, bit_width):0{digits}X}\n")
        print(f"  [EXPORT] {filename}: {len(flat)} lines, {bit_width}-bit hex {comment}")

    def save_decimal(self, filename, values, comment=""):
        """Human-readable decimal duplicate, handy for the report / manual review."""
        path = os.path.join(self.output_dir, filename)
        flat = np.asarray(values).reshape(-1)
        with open(path, "w") as f:
            for val in flat:
                f.write(f"{int(val)}\n")
        print(f"  [EXPORT] {filename}: {len(flat)} values {comment}")

    def save_json(self, filename, obj):
        path = os.path.join(self.output_dir, filename)
        with open(path, "w") as f:
            json.dump(obj, f, indent=2)
        print(f"  [EXPORT] {filename}")


def compute_golden(img, kernel):
    """Runs the full conv -> (optional ReLU) -> overflow-handling pipeline once,
    returning (raw, final, overflowed)."""
    raw = cross_correlate_valid(img, kernel)
    if Config.APPLY_RELU:
        raw = apply_relu(raw)
    final, overflowed = apply_overflow(raw, Config.OUTPUT_WIDTH, Config.OVERFLOW_MODE)
    return raw, final, overflowed


# ==============================================================================
# 5. Main pipeline
# ==============================================================================
def main():
    Config.banner()
    rng = np.random.default_rng(Config.SEED)
    exporter = Exporter(Config.EXPORT_DIR)
    lo_out, hi_out = Config.output_range()

    print("[1/3] Generating quantized kernel weights...")
    weights = generate_weights(rng)  # shape (K, K)
    exporter.save_decimal("kernel_readable.txt", weights, "(signed, decimal, row-major)")

    print("\n[2/3] Generating the PRIMARY test vector consumed directly by "
          "tb_cnn_top.sv (kernel.mem / image.mem / relu_output.mem)...")
    images = generate_test_images(rng)
    primary_name = "random"
    primary_img = images.pop(primary_name)

    exporter.save_hex_mem("kernel.mem", weights, Config.DATA_WIDTH,
                           f"(NUM_WEIGHTS={Config.KERNEL_SIZE**2}, signed)")
    exporter.save_hex_mem("image.mem", primary_img, Config.DATA_WIDTH,
                           f"(IMAGE_SIZE^2={Config.IMAGE_SIZE**2}, unsigned, row-major)")

    raw, final, overflowed = compute_golden(primary_img, weights)
    exporter.save_hex_mem("relu_output.mem", final, 16,
                           f"(OUT_DIM^2={ (Config.IMAGE_SIZE-Config.KERNEL_SIZE+1)**2 }, "
                           f"post-{'ReLU+' if Config.APPLY_RELU else ''}{Config.OVERFLOW_MODE})")
    exporter.save_decimal("relu_output_readable.txt", final, "(decimal, for the report)")
    if overflowed:
        print(f"  [WARN] '{primary_name}' saturated: raw range "
              f"[{raw.min()}, {raw.max()}] vs 16-bit range [{lo_out}, {hi_out}]")

    manifest_cases = [{
        "test_case": primary_name, "role": "primary (fed to tb_cnn_top.sv)",
        "raw_min": int(raw.min()), "raw_max": int(raw.max()),
        "overflow_triggered": overflowed,
    }]

    print("\n[3/3] Generating EXTRA edge-case vectors under "
          f"'{Config.EXPORT_DIR}/vectors/' for broader coverage "
          "(same kernel, different images - swap in by copying over the "
          "primary image.mem/relu_output.mem for additional test runs)...")
    for name, img in images.items():
        vec_dir = f"vectors/{name}"
        os.makedirs(os.path.join(Config.EXPORT_DIR, vec_dir), exist_ok=True)
        raw, final, overflowed = compute_golden(img, weights)

        exporter.save_hex_mem(f"{vec_dir}/image.mem", img, Config.DATA_WIDTH)
        exporter.save_hex_mem(f"{vec_dir}/relu_output.mem", final, 16)
        if overflowed:
            print(f"  [WARN] '{name}' saturated: raw range [{raw.min()}, {raw.max()}] "
                  f"vs 16-bit range [{lo_out}, {hi_out}]")

        manifest_cases.append({
            "test_case": name, "role": "extra coverage (vectors/ subfolder)",
            "raw_min": int(raw.min()), "raw_max": int(raw.max()),
            "overflow_triggered": overflowed,
        })

    print("\nWriting manifest / assumptions summary...")
    manifest = {
        "project": Config.PROJECT_NAME,
        "version": Config.VERSION,
        "seed": Config.SEED,
        "image_size": Config.IMAGE_SIZE,
        "kernel_size": Config.KERNEL_SIZE,
        "num_filters": Config.NUM_FILTERS,
        "stride": Config.STRIDE,
        "data_width_input_unsigned_and_weight_signed": Config.DATA_WIDTH,
        "output_width_signed": Config.OUTPUT_WIDTH,
        "relu_applied": Config.APPLY_RELU,
        "overflow_mode": Config.OVERFLOW_MODE,
        "worst_case_abs_output": Config.worst_case_abs_output(),
        "min_bits_needed_for_worst_case": Config.min_bits_for_worst_case(),
        "convolution_convention": "cross-correlation, valid (no padding), no kernel flip",
        "primary_test_case": primary_name,
        "file_formats": {
            "kernel.mem": f"{Config.KERNEL_SIZE**2} lines, {Config.DATA_WIDTH}-bit hex, "
                          "signed two's complement, row-major tap order",
            "image.mem": f"{Config.IMAGE_SIZE**2} lines, {Config.DATA_WIDTH}-bit hex, "
                         "unsigned, row-major pixel order",
            "relu_output.mem": f"{(Config.IMAGE_SIZE-Config.KERNEL_SIZE+1)**2} lines, "
                                "16-bit hex, signed two's complement, row-major",
        },
        "test_cases": manifest_cases,
    }
    exporter.save_json("manifest.json", manifest)

    print(f"\nDone. Primary vectors (kernel.mem, image.mem, relu_output.mem) are in "
          f"'{Config.EXPORT_DIR}/' - point tb_cnn_top.sv's $readmemh calls there.")


# ==============================================================================
# 6. Multi-test-case suite: 5 named kernels x 5 images, covering the classic
#    conv behaviors (identity / edge / blur / sharpen) plus saturation.
#
#    Pairing:
#      - "primary" showcase image -> ALL 5 kernels (5 cases): proves the
#        kernel is genuinely reprogrammable on one fixed input, per spec
#        item #3 ("kernel coefficients should be programmable").
#      - 4 more images -> one dedicated kernel each, chosen to stress that
#        specific kernel's behavior (edge response on a ramp/checkerboard,
#        saturation on the max-value image, generic noise on random).
#
#    Each case is exported to export/test_cases/<case_name>/ with the same
#    kernel.mem / image.mem / relu_output.mem trio tb_cnn_top.sv expects,
#    so any one of them can be dropped in place of the primary set. A
#    case_list.txt lists every case directory in order, for a testbench
#    that wants to loop over all of them in a single simulation run.
# ==============================================================================
def generate_named_kernels():
    """Returns dict[name] -> int32 (K,K) array, classic image-processing
    kernels, hand-specified (not random) so behavior is predictable and
    easy to verify by eye. Requires KERNEL_SIZE == 3."""
    assert Config.KERNEL_SIZE == 3, (
        "generate_named_kernels() ships hand-written 3x3 kernels; "
        "regenerate with different values if KERNEL_SIZE != 3."
    )
    lo, hi = Config.weight_range()
    kernels = {
        "identity":  np.array([[0, 0, 0],
                                [0, 1, 0],
                                [0, 0, 0]], dtype=np.int32),
        "edge_h":    np.array([[-1, 0, 1],       # Sobel-X: responds to vertical edges
                                [-2, 0, 2],
                                [-1, 0, 1]], dtype=np.int32),
        "edge_v":    np.array([[-1, -2, -1],     # Sobel-Y: responds to horizontal edges
                                [ 0,  0,  0],
                                [ 1,  2,  1]], dtype=np.int32),
        "sharpen":   np.array([[ 0, -1,  0],
                                [-1,  5, -1],
                                [ 0, -1,  0]], dtype=np.int32),
        "box_blur":  np.array([[1, 1, 1],        # sum-in-window; HW has no
                                [1, 1, 1],        # divider, so this is an
                                [1, 1, 1]], dtype=np.int32),  # unnormalized box filter
    }
    for name, k in kernels.items():
        assert k.min() >= lo and k.max() <= hi, f"{name} kernel out of weight_range()"
    return kernels


def generate_showcase_image():
    """One 32x32 image with four quadrants, each designed to give an
    obviously-correct response under a different kernel:
      top-left     : vertical stripes    -> strong response under edge_h
      top-right    : horizontal stripes  -> strong response under edge_v
      bottom-left  : diagonal gradient   -> smooths visibly under box_blur
      bottom-right : bright block on a dim background -> sharpen halo,
                     and pushes close to the saturation boundary
    """
    S = Config.IMAGE_SIZE
    vmax = Config.input_max()
    half = S // 2
    img = np.zeros((S, S), dtype=np.int32)

    # top-left: vertical stripes, period 4
    cols = np.arange(half)
    stripe_v = np.where((cols % 4) < 2, vmax, 0)
    img[0:half, 0:half] = np.tile(stripe_v, (half, 1))

    # top-right: horizontal stripes, period 4
    rows = np.arange(half)
    stripe_h = np.where((rows % 4) < 2, vmax, 0)
    img[0:half, half:S] = np.tile(stripe_h.reshape(-1, 1), (1, S - half))

    # bottom-left: diagonal gradient
    rr, cc = np.indices((half, half))
    grad = np.round((rr + cc) / (2 * (half - 1)) * vmax).astype(np.int32)
    img[half:S, 0:half] = grad

    # bottom-right: bright block on dim background (sharpen / saturation)
    img[half:S, half:S] = 64
    q = half // 4
    br0, br1 = half + q, S - q
    img[br0:br1, half + q: S - q] = min(vmax, 250)

    return img.astype(np.int32)


def export_multi_kernel_suite():
    print(f"\n{'=' * 80}")
    print("  Exporting 5-kernel x 5-image test-case suite -> "
          f"{Config.EXPORT_DIR}/test_cases/")
    print(f"{'=' * 80}")

    exporter = Exporter(os.path.join(Config.EXPORT_DIR, "test_cases"))
    lo_out, hi_out = Config.output_range()
    kernels = generate_named_kernels()

    rng = np.random.default_rng(Config.SEED)
    base_images = generate_test_images(rng)  # zeros, max_value, checkerboard, ramp, random
    showcase = generate_showcase_image()

    # (case_name, image, kernel_name)
    plan = [
        ("showcase_identity",      showcase,                 "identity"),
        ("showcase_edge_h",        showcase,                 "edge_h"),
        ("showcase_edge_v",        showcase,                 "edge_v"),
        ("showcase_sharpen",       showcase,                 "sharpen"),
        ("showcase_box_blur",      showcase,                 "box_blur"),
        ("checkerboard_box_blur",  base_images["checkerboard"], "box_blur"),
        ("ramp_edge_h",            base_images["ramp"],         "edge_h"),
        ("max_value_sharpen",      base_images["max_value"],    "sharpen"),
        ("random_edge_v",          base_images["random"],       "edge_v"),
    ]

    case_list = []
    manifest_cases = []
    for case_name, img, kname in plan:
        kernel = kernels[kname]
        raw, final, overflowed = compute_golden(img, kernel)

        case_dir = f"{Config.EXPORT_DIR}/test_cases/{case_name}"
        os.makedirs(case_dir, exist_ok=True)
        exporter.save_hex_mem(f"{case_name}/kernel.mem", kernel, Config.DATA_WIDTH)
        exporter.save_hex_mem(f"{case_name}/image.mem", img, Config.DATA_WIDTH)
        exporter.save_hex_mem(f"{case_name}/relu_output.mem", final, 16)

        if overflowed:
            print(f"  [WARN] '{case_name}' saturated: raw range "
                  f"[{raw.min()}, {raw.max()}] vs 16-bit range [{lo_out}, {hi_out}]")

        case_list.append(case_name)
        manifest_cases.append({
            "case": case_name, "kernel": kname,
            "raw_min": int(raw.min()), "raw_max": int(raw.max()),
            "overflow_triggered": overflowed,
        })

    with open(f"{Config.EXPORT_DIR}/test_cases/case_list.txt", "w") as f:
        for name in case_list:
            f.write(name + "\n")
    print(f"  [EXPORT] test_cases/case_list.txt: {len(case_list)} case directories, in order")

    exporter.save_json("manifest.json", {
        "num_cases": len(plan),
        "kernel_size": Config.KERNEL_SIZE,
        "image_size": Config.IMAGE_SIZE,
        "cases": manifest_cases,
    })
    print(f"\n  Done. {len(plan)} test cases under {Config.EXPORT_DIR}/test_cases/, "
          "one subfolder each with kernel.mem / image.mem / relu_output.mem.")


if __name__ == "__main__":
    main()
    export_multi_kernel_suite()
